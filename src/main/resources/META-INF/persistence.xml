<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="MOODLE_LMS">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.lms.system.model.User</class>
        <class>com.lms.system.model.Admin</class>
        <class>com.lms.system.model.Student</class>
        <class>com.lms.system.model.Teacher</class>
        <class>com.lms.system.model.Group</class>
        <class>com.lms.system.model.Assignment</class>
        <class>com.lms.system.model.Submission</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/lms_moodle_system?currentSchema=lms" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="2001" />
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />

            <property name="jakarta.persistence.schema-generation.database.action" value="none" />
        </properties>

    </persistence-unit>

</persistence>
